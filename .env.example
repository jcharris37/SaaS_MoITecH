# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env real a git.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_un_secreto_muy_largo_y_aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Base de datos ─────────────────────────────────────────────────────────────
# Local: sqlite:///./moihub.db
# Producción (Postgres): postgresql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=sqlite:///./moihub.db

# ── Super Admin ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@moihub.com
ADMIN_PASSWORD=cambia_esto_tambien

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# En desarrollo local dejamos esto vacío para que Vite use el PROXY
# En producción, pon la URL del backend si es diferente a la del frontend.
VITE_API_URL=